# Copy to `.env` for local development (loaded automatically).

SECRET_KEY=dev-secret-change-me

# Persistence backend: auto | firebase | rtdb | local
#   auto  -> Realtime Database when FIREBASE_DB_URL + a secret/credential are
#            set, else Firestore when a credential is set, else a local file
#   local -> always the local JSON file (data/matchdays.json)
#   rtdb  -> require the Realtime Database (fail fast if it cannot connect)
#   firebase -> require Firestore or RTDB (fail fast if neither connects)
DB_BACKEND=auto

# --- Realtime Database (preferred backup target) ---
# When this URL is set admins, saved match-days (scoring) and standings
# (ranking) are backed up to RTDB. The URL itself is not a secret.
FIREBASE_DB_URL=https://foot-99dee-default-rtdb.europe-west1.firebasedatabase.app/

# Simplest way to authenticate to RTDB: a legacy DATABASE SECRET (Firebase
# console -> Project settings -> Service accounts -> Database secrets). It is
# sent as ?auth= on the REST API and bypasses the rules, so rules can stay
# locked (.read/.write:false). This alone is enough — no service account.
# FIREBASE_DB_SECRET=your-database-secret

# --- Service-account credential (alternative to the secret; also enables
#     Firestore) --- ONE credential authenticates both RTDB and Firestore.
# Option A: paste the whole service-account JSON on one line (best for Render).
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...", ...}
# Option B: point to a service-account file on disk.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# --- Firestore (used only when FIREBASE_DB_URL is blank) ---
FIRESTORE_COLLECTION=matchdays

# --- Live scoring --------------------------------------------------
# Provider: auto | thesportsdb | apifootball
#   auto        -> API-Football if a key is set, else TheSportsDB (free)
#   thesportsdb -> free, current-season Tunisian Ligue 1 results + table,
#                  NO key required (public key "3"). Works out of the box.
#   apifootball -> true in-play scores, needs a key (free plan = past seasons).
LIVE_PROVIDER=auto

# TheSportsDB (the free default). Override the key only if you have your own.
# THESPORTSDB_KEY=3
# THESPORTSDB_LEAGUE_ID=4828          # Tunisian Ligue 1

# API-Football (optional upgrade for in-play). Free key: dashboard.api-football.com
# NOTE: the free plan is limited to PAST seasons, so the current season may not
# appear — use TheSportsDB for the live season.
# APIFOOTBALL_KEY=your-api-football-key
# APIFOOTBALL_LEAGUE_ID=202           # Tunisian Ligue Professionnelle 1
# APIFOOTBALL_SEASON=                 # blank = derive from today; else e.g. 2023
# APIFOOTBALL_LIVE_TTL=90             # seconds to cache live data (protect quota)
# APIFOOTBALL_STATIC_TTL=900          # seconds to cache fixtures/standings

# --- Super administrator --------------------------------------------
# The one account allowed to manage the others. If SUPER_ADMIN_PASSWORD is
# left unset the app generates a random one at start-up and prints it to the
# log once, so an unconfigured deployment is never reachable with a default.
SUPER_ADMIN_USER=superadmin
# SUPER_ADMIN_PASSWORD=change-me
FIRESTORE_ADMIN_COLLECTION=admins

# Session cookies are marked Secure by default (Render serves HTTPS).
# Set to 0 only for plain-HTTP local development.
# SESSION_COOKIE_SECURE=0
